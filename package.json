{
  "name": "@treenwang/gitkit-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "release": "npm publish --workspaces --access public",
    "playground": "npm run build && npm start --workspace @treenwang/gitkit-playground",
    "playground:react": "npm run build && npm start --workspace @treenwang/gitkit-react-playground"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "happy-dom": "^20.11.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
