{
  "name": "@treenwang/gitkit-client",
  "version": "0.1.3",
  "description": "Typed browser client for @treenwang/gitkit. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@treenwang/gitkit": "^0.1.3"
  },
  "peerDependenciesMeta": {
    "@treenwang/gitkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@treenwang/gitkit": "^0.1.3"
  },
  "engines": {},
  "publishConfig": {
    "access": "public"
  }
}
