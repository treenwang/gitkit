{
  "name": "@aaxis/gitkit-client",
  "version": "0.0.0",
  "description": "Typed browser client for @aaxis/gitkit. Zero runtime dependencies.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@aaxis/gitkit": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@aaxis/gitkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aaxis/gitkit": "workspace:*"
  }
}
