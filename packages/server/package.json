{
  "name": "@aaxis/gitkit-server",
  "version": "0.0.0",
  "description": "HTTP transport for @aaxis/gitkit. Web-standard handler plus an Express adapter.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": { "build": "tsup", "typecheck": "tsc --noEmit" },
  "dependencies": {
    "@aaxis/gitkit": "workspace:*",
    "@aaxis/gitkit-client": "workspace:*"
  }
}
