{
  "name": "@treenwang/gitkit-ui",
  "version": "0.1.1",
  "description": "React hooks and components for @treenwang/gitkit. Styled with shadcn semantic tokens; ships no CSS.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./hooks": {
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "require": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components.d.ts",
        "default": "./dist/components.js"
      },
      "require": {
        "types": "./dist/components.d.cts",
        "default": "./dist/components.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@treenwang/gitkit-client": "^0.1.1"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "@tanstack/react-query": "^5",
    "radix-ui": "^1",
    "lucide-react": "*"
  },
  "peerDependenciesMeta": {
    "radix-ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^20.11.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "engines": {},
  "publishConfig": {
    "access": "public"
  }
}
