# ------------------------------------------------------------------
# Gitkit Playground Environment Configuration
# ------------------------------------------------------------------

# Target Git repository URL (required)
# Can be a GitHub HTTPS URL or a local bare repository (file:///path/to/repo.git)
GITKIT_REPO_URL="https://github.com/treenwang/gitkit"

# GitHub Personal Access Token (PAT) with "repo" scope (required for GitHub HTTPS)
# Leave empty if testing against a local bare repository (file:///)
GITKIT_TOKEN="ghp_your_token_here"

# Sparse checkout directories (comma-separated, optional)
# - Leave blank/unset to check out the ENTIRE repository (full checkout).
# - Set specific folders to check out only those paths, e.g. "docs,packages"
GITKIT_PATHS="docs"

# Starting base branch for sessions (optional, defaults to "main")
GITKIT_BASE="main"

# Author identity for commits made via Playground (optional)
GITKIT_AUTHOR_NAME="gitkit playground"
GITKIT_AUTHOR_EMAIL="playground@example.invalid"

# Local HTTP server port (optional, defaults to 5178 for React, 5177 for HTML)
# PORT=5178
